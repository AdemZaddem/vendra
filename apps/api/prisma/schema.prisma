generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  starter
  growth
  pro
}

enum PlanStatus {
  pending_payment
  active
  suspended
}

enum MembershipRole {
  owner
  manager
  fulfillment_staff
}

model Organization {
  id            String     @id @default(uuid())
  name          String
  slug          String     @unique
  logoUrl       String?
  contactPhone  String?
  contactEmail  String?
  plan          Plan       @default(starter)
  planStatus    PlanStatus @default(pending_payment)
  planExpiresAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  memberships   Membership[]

  @@map("organizations")
}

model Profile {
  id          String   @id
  fullName    String
  email       String   @unique
  avatarUrl   String?
  phoneNumber String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships Membership[]

  @@map("profiles")
}

model Membership {
  id             String         @id @default(uuid())
  organizationId String
  profileId      String
  role           MembershipRole
  createdAt      DateTime       @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id])
  profile        Profile        @relation(fields: [profileId], references: [id])

  @@unique([organizationId, profileId])
  @@map("memberships")
}