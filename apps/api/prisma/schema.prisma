generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  starter
  growth
  pro
}

enum PlanStatus {
  pending_payment
  active
  suspended
}

enum MembershipRole {
  owner
  manager
  fulfillment_staff
}

enum Governorate {
  tunis
  ariana
  ben_arous
  manouba
  nabeul
  zaghouan
  bizerte
  beja
  jendouba
  kef
  siliana
  kairouan
  kasserine
  sidi_bouzid
  sousse
  monastir
  mahdia
  sfax
  gafsa
  tozeur
  kebili
  gabes
  medenine
  tataouine
}

model Organization {
  id            String     @id @default(uuid())
  name          String
  slug          String     @unique
  logoUrl       String?
  tagline       String?
  brandColor    String?
  themeId       String?
  contactPhone  String?
  contactEmail  String?
  category      String?
  plan          Plan       @default(starter)
  planStatus    PlanStatus @default(pending_payment)
  planExpiresAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  memberships   Membership[]
  deliveryZones DeliveryZone[]

  @@map("organizations")
}

model Profile {
  id          String   @id
  fullName    String
  email       String   @unique
  avatarUrl   String?
  phoneNumber String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships Membership[]

  @@map("profiles")
}

model Membership {
  id             String         @id @default(uuid())
  organizationId String
  profileId      String
  role           MembershipRole
  createdAt      DateTime       @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id])
  profile        Profile        @relation(fields: [profileId], references: [id])

  @@unique([organizationId, profileId])
  @@map("memberships")
}

model DeliveryZone {
  id             String       @id @default(uuid())
  organizationId String
  governorate    Governorate
  price          Decimal      @default(0) @db.Decimal(10, 2)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, governorate])
  @@map("delivery_zones")
}

